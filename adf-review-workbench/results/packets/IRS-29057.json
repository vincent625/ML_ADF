        "source_hash_matches": true
      }
    },
    {
      "id": "1501934",
      "created": "2022-06-14T22:40:23.000+0530",
      "updated": "2022-06-14T22:40:23.000+0530",
      "text": "removed the OvatRuleSet as part of OCAPlus v0.0.9 ADF",
      "truncated": false,
      "source": {
        "path": "data/raw/connected/jira/batch_probe.json",
        "sha256": "6dc4ac43f5365685a9bef55df70bc7800ea54d62d0f3f6c8fbf57e34cc1ce8a1",
