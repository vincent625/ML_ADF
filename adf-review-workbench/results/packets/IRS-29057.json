    },
    {
      "id": "1501944",
      "created": "2022-06-18T05:00:03.000+0530",
      "updated": "2022-06-18T05:00:03.000+0530",
      "text": "With ADF v0.0.9, confirm that after installation of the ADF, the ovat ruleset installed on Genexus 6.7.19 is the same as provided by Chris.",
      "truncated": false,
      "source": {
        "path": "data/raw/connected/jira/batch_probe.json",
